# Copy to .env and fill in. All three are free and take about five minutes each.
# Nothing in the pipeline falls back to sample data if a key is missing — the
# agent raises and names the signup URL instead.

# Local dev database (docker compose -f infra/docker-compose.yml up -d)
DATABASE_URL=postgresql://neighbour:neighbour@localhost:5433/neighbour_trust

# CPCB real-time AQI — PRIMARY source.
# Register at https://www.data.gov.in/ then copy the key from My Account.
DATA_GOV_IN_API_KEY=

# AQICN / WAQI — gap-filler where no CPCB station is within range.
# https://aqicn.org/data-platform/token/
AQICN_TOKEN=

# OpenAQ — 30-day historical trend. Neither CPCB nor AQICN serve history.
# https://explore.openaq.org/register
OPENAQ_API_KEY=

# Claude — classifies news headlines for the crime and water agents.
# OPTIONAL: without it the news agent falls back to a keyword heuristic that
# leaves ambiguous headlines unclassified, so incident counts under-report.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Required only if your key is identity-linked (issued to a user rather than an
# org) — those return 400 without it. Console -> Settings -> Workspaces, the id
# in the URL, formatted wrkspc_...
ANTHROPIC_WORKSPACE_ID=
# Override the classifier model if you want to trade accuracy for cost.
# NEWS_CLASSIFIER_MODEL=claude-opus-5

# Extra browser origins allowed to call the API, comma-separated. Local dev
# origins are always allowed; set this to your deployed frontend domain.
CORS_ALLOWED_ORIGINS=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Free-tier fallback for the news classifier, used when ANTHROPIC_API_KEY is
# absent or its budget is spent. Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=

# Paid fallback for the news classifier, used when the free tier is exhausted.
# Roughly $1/month at current volumes. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Which providers to try, in order. Default: groq,deepseek
CLASSIFIER_PROVIDER=
# Override the model for whichever provider is chosen.
CLASSIFIER_MODEL=
