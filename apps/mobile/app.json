{
  "expo": {
    "name": "Nestra",
    "slug": "neighbour-trust",
    "scheme": "nestra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFBFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nestra.app"
    },
    "android": {
      "package": "com.nestra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F72575"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-image"
    ],
    "extra": {
      "router": {}
    }
  }
}
