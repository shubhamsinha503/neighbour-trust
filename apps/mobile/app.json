{
  "expo": {
    "name": "Nestra",
    "slug": "neighbour-trust",
    "scheme": "nestra",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nestra503.app"
    },
    "android": {
      "package": "com.nestra503.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F72575"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBFBFA"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "router": {}
    }
  }
}
